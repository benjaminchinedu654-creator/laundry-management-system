<Window x:Class="LaundryAdminApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Laundry Express — Admin Login"
        Width="460" Height="590"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border CornerRadius="16" Background="#101935" Padding="36" BorderBrush="#283556" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" Opacity="0.6" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel>
            <!-- Logo & Brand Header -->
            <TextBlock Text="LAUNDRY" FontSize="36" FontWeight="Black"
                       Foreground="#06B6D4" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock Text="EXPRESS" FontSize="12" FontWeight="Bold"
                       Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
            <TextBlock Text="ADMIN MANAGEMENT SUITE" FontSize="10" FontWeight="SemiBold"
                       Foreground="#0891B2" HorizontalAlignment="Center" Margin="0,2,0,18"/>

            <Border Height="1" Background="#283556" Margin="0,0,0,18"/>

            <!-- Error Notification -->
            <Border x:Name="ErrorPanel" Background="#3B1515" CornerRadius="8" Padding="12,8"
                    Margin="0,0,0,14" Visibility="Collapsed" BorderBrush="#7F1D1D" BorderThickness="1">
                <TextBlock x:Name="ErrorText" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- API Server URL -->
            <TextBlock Text="API SERVER URL" FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B8" Margin="0,0,0,5"/>
            <TextBox x:Name="ServerUrlBox" Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,14" Height="38"/>

            <!-- Admin Email -->
            <TextBlock Text="ADMIN EMAIL" FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B8" Margin="0,0,0,5"/>
            <TextBox x:Name="EmailBox" Style="{StaticResource ModernTextBox}"
                     Margin="0,0,0,14" Height="38"/>

            <!-- Password -->
            <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold"
                       Foreground="#94A3B8" Margin="0,0,0,5"/>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource ModernPasswordBox}"
                         Margin="0,0,0,20" Height="38"/>

            <!-- Login Action Button -->
            <Button x:Name="LoginBtn" Content="SIGN IN TO ADMIN SUITE"
                    Style="{StaticResource PrimaryButton}"
                    Height="44" FontSize="13"
                    Click="LoginBtn_Click"/>

            <!-- Connection Status -->
            <TextBlock x:Name="StatusText" Text="" Foreground="#94A3B8"
                       FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>

            <!-- Window Close -->
            <Button Content="Cancel &amp; Exit" Background="Transparent" Foreground="#64748B" BorderThickness="0"
                    FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0" Cursor="Hand"
                    Click="CloseBtn_Click"/>
        </StackPanel>
    </Border>
</Window>
