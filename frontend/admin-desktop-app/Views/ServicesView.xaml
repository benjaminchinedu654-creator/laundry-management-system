<UserControl x:Class="LaundryAdminApp.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- Services Catalog Left Side -->
        <DockPanel Grid.Column="0" Margin="10,4,16,16">
            <!-- Filter Bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Category:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategory}"
                                  Style="{StaticResource ModernComboBox}" Width="160" Height="34" Margin="0,0,14,0"/>
                        <Button Content="Refresh Catalog" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" Height="34"/>
                    </StackPanel>

                    <Button Content="+ New Service" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ResetFormCommand}" HorizontalAlignment="Right" Height="34" Padding="14,0"/>
                </Grid>
            </Border>

            <!-- Status Indicator -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                       Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>

            <!-- Services Grid -->
            <Border Background="#101935" CornerRadius="12" Padding="6" BorderBrush="#283556" BorderThickness="1">
                <DataGrid ItemsSource="{Binding FilteredServices}" SelectedItem="{Binding SelectedService}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#172242" AlternatingRowBackground="#121C38"
                          Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Item / Service Name" Binding="{Binding Name}" Width="170"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130"/>
                        <DataGridTextColumn Header="Unit Price" Binding="{Binding FormattedPrice}" Width="110"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusBadge}" Width="90"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Service Form Right Side -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,4,10,16" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="SERVICE EDITOR" FontSize="12" FontWeight="Black"
                               Foreground="#06B6D4" Margin="0,0,0,14"/>

                    <TextBlock Text="SERVICE NAME" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="CATEGORY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding FormCategories}" SelectedItem="{Binding FormCategory}"
                              Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="UNIT PRICE (₦)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormPrice, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="DESCRIPTION / NOTES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>

                    <CheckBox IsChecked="{Binding FormIsAvailable}" Content="Service is Active &amp; Available for Booking"
                              Foreground="#F8FAFC" FontSize="12" Margin="0,0,0,18"/>

                    <Button Content="{Binding IsEditMode, ConverterParameter='Update Service', FallbackValue='Save Service'}"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Height="40" Margin="0,0,0,8"/>

                    <Button Content="Clear Form" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetFormCommand}" Height="36" Margin="0,0,0,8"/>

                    <Button Content="Delete Selected Service" Style="{StaticResource DangerButton}"
                            Command="{Binding DeleteCommand}" Height="36"
                            Visibility="{Binding IsEditMode, Converter={x:Null}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
