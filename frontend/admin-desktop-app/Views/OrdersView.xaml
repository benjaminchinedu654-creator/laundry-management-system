<UserControl x:Class="LaundryAdminApp.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Orders Table & Filter Left Column -->
        <DockPanel Grid.Column="0" Margin="10,4,16,16">
            <!-- Filter & Search Bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Status:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                                  Style="{StaticResource ModernComboBox}" Width="130" Height="34" Margin="0,0,12,0"/>

                        <TextBlock Text="Payment:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding PaymentOptions}" SelectedItem="{Binding SelectedPayment}"
                                  Style="{StaticResource ModernComboBox}" Width="100" Height="34" Margin="0,0,14,0"/>

                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" Height="34"/>
                    </StackPanel>

                    <!-- Search Input -->
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalAlignment="Right" Width="200" Height="34"
                             Tag="Search order or customer..."/>
                </Grid>
            </Border>

            <!-- Status Indicator -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                       Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>

            <!-- Orders Grid -->
            <Border Background="#101935" CornerRadius="12" Padding="6" BorderBrush="#283556" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#172242" AlternatingRowBackground="#121C38"
                          Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderCode}" Width="150"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding DisplayCustomer}" Width="140"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding UserPhone}" Width="110"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding FormattedTotal}" Width="100"/>
                        <DataGridTextColumn Header="Stage" Binding="{Binding StatusDisplay}" Width="120"/>
                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentStatus}" Width="85"/>
                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Order Inspector Sidebar Right Column -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,4,10,16" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="ORDER DETAILS" FontSize="12" FontWeight="Black"
                               Foreground="#06B6D4" Margin="0,0,0,12"/>

                    <!-- Summary Header -->
                    <Border Background="#101935" CornerRadius="10" Padding="14" Margin="0,0,0,14" BorderBrush="#283556" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOrder.OrderCode, FallbackValue='No Order Selected'}"
                                       FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{Binding SelectedOrder.CreatedAt, StringFormat='{}Placed on: {0}', FallbackValue='Select an order to inspect'}"
                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Background="#06B6D4" CornerRadius="6" Padding="10,3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedOrder.StatusDisplay, FallbackValue='STAGE'}"
                                               FontSize="11" FontWeight="Bold" Foreground="#041E26"/>
                                </Border>
                                <Border Background="#233157" CornerRadius="6" Padding="10,3">
                                    <TextBlock Text="{Binding SelectedOrder.PaymentStatus, FallbackValue='PAYMENT'}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="#67E8F9"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Customer Contact Info -->
                    <TextBlock Text="CUSTOMER CONTACT" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border Background="#101935" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedOrder.DisplayCustomer, FallbackValue='--'}" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock Text="{Binding SelectedOrder.UserPhone, StringFormat='{}Phone: {0}', FallbackValue='Phone: --'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding SelectedOrder.UserEmail, StringFormat='{}Email: {0}', FallbackValue='Email: --'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Pickup & Delivery Schedule -->
                    <TextBlock Text="PICKUP &amp; DELIVERY" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border Background="#101935" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Pickup Address:" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                            <TextBlock Text="{Binding SelectedOrder.PickupAddress, FallbackValue='--'}" FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding SelectedOrder.PickupDate, StringFormat='{}Date: {0}', FallbackValue='Date: --'}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding SelectedOrder.PickupTime, StringFormat='{}Time: {0}', FallbackValue='Time: --'}" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>

                            <Border Height="1" Background="#283556" Margin="0,0,0,10"/>

                            <TextBlock Text="Delivery Address:" FontSize="11" FontWeight="SemiBold" Foreground="#34D399"/>
                            <TextBlock Text="{Binding SelectedOrder.DeliveryAddress, FallbackValue='--'}" FontSize="12" Foreground="#F8FAFC" TextWrapping="Wrap" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding SelectedOrder.DeliveryDate, StringFormat='{}Date: {0}', FallbackValue='Date: --'}" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding SelectedOrder.DeliveryTime, StringFormat='{}Time: {0}', FallbackValue='Time: --'}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <!-- Ordered Items -->
                    <TextBlock Text="ORDER ITEMS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border Background="#101935" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedOrder.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#283556" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding ServiceName}" FontWeight="SemiBold" FontSize="12" Foreground="#F8FAFC"/>
                                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#94A3B8"/>
                                                    <TextBlock Text="{Binding FormattedUnitPrice, StringFormat='{}Rate: {0}'}" FontSize="10" Foreground="#64748B"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Quantity, StringFormat='{}Qty: {0}'}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FormattedLineTotal}" FontSize="12" FontWeight="Bold" Foreground="#06B6D4" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0,10,0,0">
                                <TextBlock Text="Order Total:" FontSize="13" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock Text="{Binding SelectedOrder.FormattedTotal, FallbackValue='₦0'}"
                                           FontSize="16" FontWeight="Black" Foreground="#06B6D4" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Status Action Panel -->
                    <TextBlock Text="UPDATE ORDER STAGE" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border Background="#101935" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding UpdatableStatuses}" SelectedItem="{Binding NewStatusSelection}"
                                      Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,8"/>
                            <Button Content="Apply Stage Update" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding UpdateStatusCommand}" Height="36"/>
                        </StackPanel>
                    </Border>

                    <!-- Payment Action Panel -->
                    <TextBlock Text="UPDATE PAYMENT STATUS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <Border Background="#101935" CornerRadius="8" Padding="12">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding UpdatablePaymentStatuses}" SelectedItem="{Binding NewPaymentSelection}"
                                      Style="{StaticResource ModernComboBox}" Height="34" Margin="0,0,0,8"/>
                            <Button Content="Apply Payment Update" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding UpdatePaymentCommand}" Height="36"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
