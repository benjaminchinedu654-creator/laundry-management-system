<UserControl x:Class="LaundryAdminApp.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="10,4,10,16">
        <!-- Top Toolbar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh Directory" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" Height="34" Margin="0,0,14,0"/>
                    <Button Content="Toggle Active/Suspended" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ToggleStatusCommand}" Height="34"/>
                </StackPanel>

                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Right" Width="260" Height="34"
                         Tag="Search customer name, email, phone..."/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                   Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>

        <!-- Customers Table -->
        <Border Background="#101935" CornerRadius="12" Padding="6" BorderBrush="#283556" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      Background="Transparent" BorderThickness="0"
                      RowBackground="#172242" AlternatingRowBackground="#121C38"
                      Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Full Name" Binding="{Binding FullName}" Width="160"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="200"/>
                    <DataGridTextColumn Header="Account Status" Binding="{Binding StatusText}" Width="120"/>
                    <DataGridTextColumn Header="Registered Date" Binding="{Binding CreatedAt}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
