<UserControl x:Class="LaundryAdminApp.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14,6,14,20">
            <!-- Top Controls -->
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Financial &amp; Revenue Reports" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#94A3B8"
                               Margin="16,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="Recalculate Report" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Padding="14,7"/>
            </Grid>

            <!-- Revenue Summary Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,18" Padding="20">
                <StackPanel>
                    <TextBlock Text="SETTLED REVENUE (LAST 30 DAYS)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding TotalRevenueFormatted, FallbackValue='₦0'}"
                               FontSize="32" FontWeight="Black" Foreground="#06B6D4"/>
                    <TextBlock Text="Based on fully paid customer laundry orders" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Daily Revenue Breakdown Grid -->
            <Border Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Daily Revenue Log" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,14"/>
                    <DataGrid ItemsSource="{Binding DailyRevenue}" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#101935" BorderThickness="0"
                              RowBackground="#172242" AlternatingRowBackground="#121C38"
                              Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                              MinHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Day}" Width="200"/>
                            <DataGridTextColumn Header="Collected Revenue" Binding="{Binding FormattedRevenue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
