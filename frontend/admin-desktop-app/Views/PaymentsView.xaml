<UserControl x:Class="LaundryAdminApp.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- Payments Ledger Table Left Side -->
        <DockPanel Grid.Column="0" Margin="10,4,16,16">
            <!-- Filter Bar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Status:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}"
                                  Style="{StaticResource ModernComboBox}" Width="110" Height="34" Margin="0,0,12,0"/>

                        <TextBlock Text="Method:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding MethodFilters}" SelectedItem="{Binding SelectedMethod}"
                                  Style="{StaticResource ModernComboBox}" Width="100" Height="34" Margin="0,0,14,0"/>

                        <Button Content="Refresh Ledger" Style="{StaticResource SecondaryButton}"
                                Command="{Binding RefreshCommand}" Height="34"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
                       Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0"/>

            <!-- Payments Table -->
            <Border Background="#101935" CornerRadius="12" Padding="6" BorderBrush="#283556" BorderThickness="1">
                <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0"
                          RowBackground="#172242" AlternatingRowBackground="#121C38"
                          Foreground="#F8FAFC" GridLinesVisibility="None" HeadersVisibility="Column"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                        <DataGridTextColumn Header="Order #" Binding="{Binding OrderCode}" Width="140"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="150"/>
                        <DataGridTextColumn Header="Amount" Binding="{Binding FormattedAmount}" Width="100"/>
                        <DataGridTextColumn Header="Method" Binding="{Binding MethodDisplay}" Width="85"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="95"/>
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="130"/>
                        <DataGridTextColumn Header="Paid At" Binding="{Binding PaidAt}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Record Payment Form Right Side -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,4,10,16" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="RECORD PAYMENT" FontSize="12" FontWeight="Black"
                               Foreground="#06B6D4" Margin="0,0,0,14"/>

                    <TextBlock Text="ORDER ID" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormOrderId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="AMOUNT (₦)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormAmount, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="PAYMENT METHOD" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding FormMethods}" SelectedItem="{Binding FormMethod}"
                              Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="PAYMENT STATUS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding FormStatuses}" SelectedItem="{Binding FormStatus}"
                              Style="{StaticResource ModernComboBox}" Height="36" Margin="0,0,0,12"/>

                    <TextBlock Text="GATEWAY REFERENCE (OPTIONAL)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormReference, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}" Height="36" Margin="0,0,0,18"/>

                    <Button Content="Save Manual Payment" Style="{StaticResource PrimaryButton}"
                            Command="{Binding RecordPaymentCommand}" Height="40"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
