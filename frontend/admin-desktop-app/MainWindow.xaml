<Window x:Class="LaundryAdminApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LaundryAdminApp.ViewModels"
        xmlns:views="clr-namespace:LaundryAdminApp.Views"
        Title="Midarafa Laundry Service — Admin Suite" Icon="icon.ico"
        Width="1280" Height="820"
        MinWidth="1080" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#0B132B">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PaymentsViewModel}">
            <views:PaymentsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="#101935" BorderBrush="#283556" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,16">
                    <TextBlock Text="MIDARAFA" FontSize="26" FontWeight="Black"
                               Foreground="#06B6D4" HorizontalAlignment="Center"/>
                    <TextBlock Text="LAUNDRY SERVICE" FontSize="11" FontWeight="Bold"
                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    <TextBlock Text="ADMIN MANAGEMENT SUITE" FontSize="9" FontWeight="Medium"
                               Foreground="#0891B2" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    <Border Height="1" Background="#283556" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Admin Profile Badge -->
                <Border DockPanel.Dock="Top" Background="#172242" CornerRadius="10" Margin="14,0,14,18" Padding="14,10"
                        BorderBrush="#283556" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{Binding AdminDisplayName}" FontSize="13"
                                   Foreground="#F8FAFC" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AdminEmail}" FontSize="11" Foreground="#06B6D4"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Logout Button at Bottom -->
                <Button DockPanel.Dock="Bottom" Content="Exit Portal (Logout)" Style="{StaticResource NavButton}"
                        Foreground="#EF4444" Margin="14,8,14,20"
                        Command="{Binding LogoutCommand}"/>

                <!-- Navigation Links -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,0">
                        <Button Content="Dashboard Overview" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                        <Button Content="Orders Management" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Orders"/>
                        <Button Content="Services &amp; Pricing" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Services"/>
                        <Button Content="Customer Directory" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Customers"/>
                        <Button Content="Payments Ledger" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Payments"/>
                        <Button Content="Financial Reports" Style="{StaticResource NavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Reports"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN VIEW AREA -->
        <Grid Grid.Column="1" Background="#0B132B">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="#101935" BorderBrush="#283556" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ActiveSection}"
                               FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#10B981" CornerRadius="4" Width="8" Height="8" Margin="0,0,8,0"/>
                        <TextBlock Text="Laundry App Live System (localhost:8000)" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentPresenter Grid.Row="1" Content="{Binding CurrentView}"/>
        </Grid>
    </Grid>
</Window>
